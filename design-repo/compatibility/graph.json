  "granularityPolicy": {
    "why": "A section is the retrieval unit: one responsibility, bounded copy/imagery, reusable on its own. Composites in the code (RoleTabs+card, Pricing cards+table, Engine header+rows, legacy bands, AboutBand) are split into separate contracts.",
    "wordBudgetRule": "maxWords = ceil(measuredChars * 1.25 / 4.5): spec character length at ~4.5 chars/word plus 25% headroom; fields with no measured length say 'inferred'.",
    "maxContentFields": 7,
    "maxCopyCapacityWords": 2000,
    "maxImageCapacity": 15,
    "maxItemCapacity": 16,
    "exceptions": {
      "longform": "Article/prose bodies are long by nature (blog posts measured at ~2,200 words); bounded per block instead.",
      "content-listing": "Index pages show 10 full, unclamped excerpts per page (content §1: excerpts ~50-750 chars, not clamped).",
      "link-directory": "Link directories (resources index ~1,745 links, ~73,000u tall) are one responsibility with an unbounded list."
    },
    "heightsAreRecordedNotGated": "Measured heights (u at 1440/768/390, incl. pin runways) are recorded per contract for retrieval; they are not an admission gate because many spec heights are for composite blocks.",
    "genericIdLeaves": [
      "block",
      "section",
      "container",
      "wrapper",
      "group",
      "content",
      "div",
      "misc"
    ]
  },
